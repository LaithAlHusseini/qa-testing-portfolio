{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
  "tests/**/*.ts",
  "pages/**/*.ts",
  "fixtures/**/*.ts",
  "test-data/**/*.ts",
  "playwright.config.ts"
]
}